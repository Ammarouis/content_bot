# --- Required ---
BOT_TOKEN=123456:ABC-your-token
# Comma separated Telegram IDs of bootstrap admins (cannot be removed from inside the bot)
ADMIN_IDS=111111111
# Channel IDs (bot must be admin with "post" + "delete" permissions in all four)
TEMP_PDF_CHANNEL_ID=-1001111111111
TEMP_TEX_CHANNEL_ID=-1002222222222
APPROVED_PDF_CHANNEL_ID=-1003333333333
APPROVED_TEX_CHANNEL_ID=-1004444444444

# --- Optional ---
DATABASE_PATH=data/itgenix.db
LOG_LEVEL=INFO
LOG_FORMAT=json            # json | text
DISPLAY_TIMEZONE=Asia/Damascus
MAX_PDF_SIZE_MB=50
MAX_TEX_SIZE_MB=10
CLEANUP_INTERVAL_SECONDS=30
CLEANUP_MAX_ATTEMPTS=12
PREVIEW_TTL_HOURS=24
STALE_OPERATION_MINUTES=10
